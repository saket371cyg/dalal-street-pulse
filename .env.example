# ====================================================================
# Indian Stock Market Intelligence Platform - Environment Configuration
# ====================================================================

# 1. MongoDB Database
# Provide a MongoDB Atlas connection string or local MongoDB instance
# e.g., mongodb://localhost:27017/stock_market_ai or mongodb+srv://<user>:<password>@cluster.mongodb.net/stock_market_ai
MONGODB_URI=mongodb://localhost:27017/stock_market_ai

# 2. Authentication (Better Auth)
# Generate a secure secret using: openssl rand -base64 32
BETTER_AUTH_SECRET=super_secret_indian_stock_market_auth_key_32chars_minimum
BETTER_AUTH_URL=http://localhost:3000

# 3. Market Data Providers (Indian Equities: NSE / BSE)
# Candidate 1: TrueData Authorized Market Data Feed (NSE/BSE Real-Time & Historical)
# When configured, server initiates real-time WebSocket tick stream and queries REST getbars API.
# In absence of credentials, server operates in authorized EVALUATION_STANDBY mode.
TRUE_DATA_USERNAME=
TRUE_DATA_PASSWORD=
TRUE_DATA_WS_URL=wss://realtime.truedata.in
TRUE_DATA_HISTORY_URL=https://history.truedata.in

# Candidate 2: EODHD Indian Market Coverage (Historical statements, balance sheets, news)
EODHD_API_TOKEN=

# Active ingestion provider selection: HYBRID | TRUEDATA | EODHD | EXCHANGE_MASTER
MARKET_DATA_PROVIDER=HYBRID

# 4. AI Provider Configuration
# Supported providers: Google Gemini / OpenAI / Anthropic
# Defaulting to Gemini 1.5 Flash for high-speed grounded analysis
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# 5. Inngest Background Workflows
# Required for running scheduled workflows and event-driven price alert checks
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# 6. Email Notifications & Daily Briefings (SMTP)
# Configure SMTP credentials for email price alerts & daily briefings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dalal Street Pulse <no-reply@dalalstreetpulse.com>"

# 7. Application Settings
NEXT_PUBLIC_APP_NAME="Dalal Street Pulse"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
