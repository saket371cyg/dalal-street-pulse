# ====================================================================
# Dalal Street Pulse - Environment Configuration Template
# ====================================================================
# Copy this file to .env.local for local development.
# Do NOT commit real credentials or secrets to Git.
#
# NOTE: The application gracefully handles missing optional credentials.
# If external market data or AI keys are omitted, Dalal Street Pulse
# operates in evaluation standby mode with verified offline datasets
# and deterministic quantitative valuation engines.
# ====================================================================

# --------------------------------------------------------------------
# 1. Database Configuration (Optional / Local Dev Default)
# --------------------------------------------------------------------
# Provide a MongoDB connection string (local or MongoDB Atlas).
# In local development without MongoDB running, an in-memory fallback
# store is utilized for evaluation.
MONGODB_URI=mongodb://localhost:27017/stock_market_ai

# --------------------------------------------------------------------
# 2. AI & Financial Intelligence (Optional)
# --------------------------------------------------------------------
# Google Gemini API key used for natural language AI financial analyst.
# If omitted, the platform uses deterministic, grounded financial models
# with quantitative evidence and rule-based scoring.
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# --------------------------------------------------------------------
# 3. Indian Market Data Providers (NSE & BSE) (Optional)
# --------------------------------------------------------------------
# Candidate 1: TrueData Authorized Market Data Feed (NSE/BSE Real-Time & Historical)
# When configured, server initiates real-time WebSocket tick streams.
# In absence of credentials, server operates in EVALUATION_STANDBY mode.
TRUE_DATA_USERNAME=
TRUE_DATA_PASSWORD=
TRUE_DATA_WS_URL=wss://realtime.truedata.in
TRUE_DATA_BASE_URL=https://api.truedata.in
TRUE_DATA_HISTORY_URL=https://history.truedata.in

# Candidate 2: EODHD Indian Market Coverage (Corporate statements & fundamentals)
EODHD_API_TOKEN=

# Ingestion provider mode: HYBRID | TRUEDATA | EODHD | EXCHANGE_MASTER
MARKET_DATA_PROVIDER=HYBRID

# --------------------------------------------------------------------
# 4. Background Job Orchestration (Optional)
# --------------------------------------------------------------------
# Required for running Inngest scheduled workflows and event-driven alert triggers
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --------------------------------------------------------------------
# 5. Alert Notifications & Daily Briefing Dispatch (SMTP) (Optional)
# --------------------------------------------------------------------
# Configure SMTP credentials to enable automated price alert emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dalal Street Pulse <no-reply@dalalstreetpulse.com>"

# --------------------------------------------------------------------
# 6. Application UI Settings (Optional)
# --------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Dalal Street Pulse"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
